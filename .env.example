# AI-Agents-MLOps-Course - Chapter 3 Environment Configuration
# Copy this file to .env and fill in your actual values

# ===================================================================
# LLM Configuration (Groq)
# ===================================================================
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"
# llama-4-scout was shut down on 2026-07-17 (see console.groq.com/docs/deprecations)
GROQ_MODEL_NAME="openai/gpt-oss-20b"
# Optional: OpenAI-compatible endpoint used with GROQ_API_KEY.
# Empty or commented = Groq (https://api.groq.com/openai/v1). Set it only to use another endpoint.
# LLM_API_BASE="https://api.groq.com/openai/v1"

# ===================================================================
# Agent guardrails (optional)
# ===================================================================
AGENT_RECURSION_LIMIT="12"      # Max graph steps per diagnosis (LLM calls + tool runs)
TOOL_OUTPUT_MAX_CHARS="2000"    # Max characters of each tool result sent to the LLM

# ===================================================================
# LangSmith Tracing (Optional but Recommended)
# ===================================================================
# Get your LangSmith API key from: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your-langsmith-api-key-here"
# LANGCHAIN_PROJECT="AIOPS - Chapter 3"
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ===================================================================
# Monitoring Stack URLs (Docker internal networking)
# ===================================================================
# These are the default values when running with docker-compose
PROMETHEUS_URL="http://prometheus:9090"
LOKI_URL="http://loki:3100"
GRAFANA_URL="http://grafana:3000"
