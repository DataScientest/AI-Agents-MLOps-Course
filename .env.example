# AI-Agents-MLOps-Course - Chapter 6 Environment Configuration
# Copy this file to .env and fill in your actual values

# ===================================================================
# LLM Configuration
# ===================================================================
# Option 1: Groq through its OpenAI-compatible API (recommended for the course)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL_NAME="meta-llama/llama-4-scout-17b-16e-instruct"
# LLM_API_BASE="https://api.groq.com/openai/v1"

# Option 2: OpenAI
# OPENAI_API_KEY="sk-your-openai-api-key-here"
# OPENAI_MODEL_NAME="gpt-4o-mini"
# LLM_API_BASE="https://api.openai.com/v1"

# ===================================================================
# LangSmith Tracing (Optional but Recommended)
# ===================================================================
# Get your LangSmith API key from: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your-langsmith-api-key-here"
# LANGCHAIN_PROJECT="AIOPS - Chapter 6"
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ===================================================================
# PostgreSQL Database (for Checkpoints + Knowledge Base)
# ===================================================================
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="agent_checkpoints"
POSTGRES_USER="agent_user"
POSTGRES_PASSWORD="agent_password"

# ===================================================================
# RAG Configuration (Embeddings)
# ===================================================================
# IMPORTANT: Groq does NOT support embeddings!
# Choose one of the two providers below:

# Provider: "huggingface-tei" (FREE, recommended) or "openai" (paid, premium quality)
EMBEDDING_PROVIDER="huggingface-tei"

# --- Option 1: HuggingFace TEI (FREE, Self-Hosted) ---
# No API key needed! Runs in Docker.
HUGGINGFACE_TEI_URL="http://tei:8080"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# --- Option 2: OpenAI (PAID) ---
# Uncomment and use if you prefer OpenAI (change EMBEDDING_PROVIDER to "openai")
# OPENAI_API_KEY="sk-your-openai-api-key-here"
# OPENAI_API_BASE="https://api.openai.com/v1"
# EMBEDDING_MODEL="text-embedding-ada-002"

# ===================================================================
# RAG Search Parameters
# ===================================================================
RAG_TOP_K="3"                     # Number of similar incidents to retrieve
RAG_SIMILARITY_THRESHOLD="0.7"   # Minimum similarity score (0.0-1.0)

# ===================================================================
# API Gateway (Chapter 6)
# ===================================================================
API_GATEWAY_URL="http://api-gateway:8080"

# ===================================================================
# Microservices URLs (Docker internal networking)
# ===================================================================
AGENT_CORE_SERVICE_URL="http://agent-core:8000"
KNOWLEDGE_BASE_SERVICE_URL="http://knowledge-base:8001"
PROMETHEUS_TOOL_SERVICE_URL="http://prometheus-tool:8002"
# Chapter 6 (MCP): "http" = legacy proxy, "mcp" = MCP 2026-07-28 endpoint
PROMETHEUS_TRANSPORT="http"
LOKI_TOOL_SERVICE_URL="http://loki-tool:8003"
GRAFANA_TOOL_SERVICE_URL="http://grafana-tool:8004"
SYSTEM_TOOL_SERVICE_URL="http://system-tool:8005"

# ===================================================================
# Monitoring Stack URLs (Docker internal networking)
# ===================================================================
PROMETHEUS_URL="http://prometheus:9090"
LOKI_URL="http://loki:3100"
GRAFANA_URL="http://grafana:3000"

# ===================================================================
# Sample Data Loading (for testing/demo)
# ===================================================================
LOAD_SAMPLE_DATA="true"   # Set to "true" to auto-load sample incidents on startup
